pkgbase = faro
	pkgdesc = A terminal client for Signal, built for people who live in tmux
	pkgver = 0.1.0
	pkgrel = 1
	url = https://getfaro.dev
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-only

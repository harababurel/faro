	makedepends = cargo
	makedepends = protobuf
	makedepends = cmake
	makedepends = clang
	depends = glibc
	depends = libgcc
	depends = openssl
	optdepends = xdg-utils: open links and attachments
	optdepends = mpv: play voice notes (or ffmpeg, pipewire, alsa-utils)
	optdepends = ffmpeg: read voice notes that are not WAV
	optdepends = whisper.cpp: transcribe voice notes locally
	optdepends = libsecret: read the remote transcription API key from the keyring
	options = !lto
	options = !debug
